# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI
GEMINI_API_KEY=your_gemini_api_key
# API service only (direct OpenAI Responses API text generation)
OPENAI_API_KEY=your_api_openai_api_key

# Telefun
VITE_TELEFUN_WS_URL=ws://localhost:3002
# Set a separate OPENAI_API_KEY in the Telefun service if TELEFUN_OPENAI_ENABLED=true
TELEFUN_OPENAI_ENABLED=true

# API service only (internal scoring trust boundary)
TELEFUN_INTERNAL_URL=http://localhost:3002

# Same high-entropy value on API and Telefun services (server-only, never VITE_)
TELEFUN_INTERNAL_TOKEN=replace_with_random_internal_token

# App — used for auth redirects (reset password, OAuth)
VITE_APP_URL=http://localhost:3005

# MCP
CONTEXT7_API_KEY=placeholder_for_context7_api_key
