# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI
GEMINI_API_KEY=your_gemini_api_key
# API service only: direct OpenAI text generation remains enabled.
OPENAI_API_KEY=your_api_openai_api_key

# Telefun — Gemini Live only. GPT Realtime work is concluded and permanently
# disabled for every user. Historical rows remain readable; owner-bound DELETE
# cleanup may use the optional server-only reference key.
VITE_TELEFUN_WS_URL=ws://localhost:3002
TELEFUN_OPENAI_WEBRTC_ORPHAN_KEY=
# Retired compatibility inputs: ignored/no-op; never enable a Telefun start path.
# TELEFUN_OPENAI_ENABLED=
# TELEFUN_OPENAI_WEBRTC_POC_ENABLED=
# TELEFUN_OPENAI_WEBRTC_ALLOWED_USER_IDS=
# TELEFUN_OPENAI_WEBRTC_ALLOWED_MODEL_IDS=

# API service only (internal scoring trust boundary)
TELEFUN_INTERNAL_URL=http://localhost:3002

# Same high-entropy value on API and Telefun services (server-only, never VITE_)
TELEFUN_INTERNAL_TOKEN=replace_with_random_internal_token

# ── SIDAK — Jadwal Shifting (WFM Dash Pro, READ-ONLY) ──────────────────────
# Backend-only. JANGAN pakai prefix VITE_ (akan masuk bundle browser).
# Jangan pernah menaruh credential riil di repo, log, query string, atau artefak test.
# Tiga env berikut wajib ada di service API; tanpa salah satu, endpoint menjawab
# 503 WFM_NOT_CONFIGURED. URL harus cocok dengan exact origin allowlist di bawah.
WFM_SCHEDULE_SUPABASE_URL=https://dgcsjgskxrjvomruodyb.supabase.co
WFM_SCHEDULE_SUPABASE_KEY=
WFM_SCHEDULE_API_ALLOWED_ORIGINS=https://dgcsjgskxrjvomruodyb.supabase.co
# Gunakan key yang memang disetujui untuk backend ini dengan hak baca minimum/RLS.
# Jangan gunakan service-role key tanpa persetujuan pemilik dan verifikasi kebijakan akses.
# Opsional. Batas default: timeout 10000 ms, 500 baris harian, 3000 baris
# bulanan, rentang tanggal/bulan ±31 hari.
# WFM_SCHEDULE_TIMEOUT_MS=10000
# WFM_SCHEDULE_MAX_ROWS=500
# WFM_SCHEDULE_MAX_MONTH_ROWS=3000
# WFM_SCHEDULE_MAX_DATE_OFFSET_DAYS=31
# Zona waktu hanya memilih tanggal/bulan default saat `date`/`month` tidak dikirim.
# Sudah dikonfirmasi: Asia/Jakarta. Tetap opsional jika pemanggil mengirim `date`.
WFM_SCHEDULE_TIMEZONE=Asia/Jakarta
# Production tetap NO-GO sampai tipe/izin key, RLS, runtime env, dan smoke test role diverifikasi.

# E2E (Playwright) — optional, never commit real token/magic link
# Untuk test mock (default): tidak perlu diisi. Untuk test magic link real: isi email test staging-safe.
E2E_TEST_EMAIL=trainer.visual@trainers.local

# App — used for auth redirects (reset password, OAuth)
VITE_APP_URL=http://localhost:3005

# MCP
CONTEXT7_API_KEY=placeholder_for_context7_api_key
