FROM node:22.23.4-bookworm-slim AS build

RUN npm install -g --no-fund --no-audit pnpm@12.9.1

WORKDIR /app
COPY . .
# The web build runs `tsc` over all of src/, and a web test imports Telefun
# source, so Telefun's dependencies must be linked too.
RUN pnpm install --frozen-lockfile \
  --filter "@trainers/web..." --filter "@trainers/telefun..."

ARG VITE_API_URL
ARG VITE_APP_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_TELEFUN_WS_URL
ENV VITE_API_URL=${VITE_API_URL} \
  VITE_APP_URL=${VITE_APP_URL} \
  VITE_SUPABASE_URL=${VITE_SUPABASE_URL} \
  VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY} \
  VITE_TELEFUN_WS_URL=${VITE_TELEFUN_WS_URL}

RUN set -eu; \
  missing=""; \
  if [ -z "$VITE_API_URL" ]; then missing="$missing VITE_API_URL"; fi; \
  if [ -z "$VITE_APP_URL" ]; then missing="$missing VITE_APP_URL"; fi; \
  if [ -z "$VITE_SUPABASE_URL" ]; then missing="$missing VITE_SUPABASE_URL"; fi; \
  if [ -z "$VITE_SUPABASE_ANON_KEY" ]; then missing="$missing VITE_SUPABASE_ANON_KEY"; fi; \
  if [ -z "$VITE_TELEFUN_WS_URL" ]; then missing="$missing VITE_TELEFUN_WS_URL"; fi; \
  if [ -n "$missing" ]; then \
    printf 'ERROR: required web build arguments are empty:%s\n' "$missing" >&2; \
    exit 1; \
  fi

RUN pnpm --filter @trainers/web build \
  && pnpm --filter @trainers/web deploy --prod --legacy /runtime-deploy

FROM node:22.23.4-bookworm-slim AS runtime

# Coolify runs its health check inside the container with curl (or wget).
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build --chown=node:node /runtime-deploy/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/web/dist ./dist
COPY --from=build --chown=node:node /app/apps/web/scripts/serve-static.mjs ./scripts/serve-static.mjs

ENV NODE_ENV=production PORT=3005
EXPOSE 3005
USER node
CMD ["node", "scripts/serve-static.mjs"]
