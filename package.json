{
  "name": "trainers-superapp",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "pnpm run start:web",
    "start:web": "pnpm --filter @trainers/web start",
    "build:web": "pnpm turbo run build --filter @trainers/web",
    "start:api": "pnpm --filter @trainers/api start",
    "start:telefun-scoring-worker": "pnpm --filter @trainers/api start:telefun-scoring-worker",
    "build:api": "pnpm turbo run build --filter @trainers/api",
    "start:telefun": "pnpm --filter @trainers/telefun start",
    "build:telefun": "pnpm turbo run build --filter @trainers/telefun",
    "start:all": "turbo run start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:targeted": "turbo test:targeted",
    "test:affected": "turbo test:targeted",
    "test:core": "turbo test:core",
    "test:fast": "turbo test:fast",
    "test:full": "turbo test:full",
    "test:db-integration": "pnpm --filter @trainers/api test:db-integration",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "seed": "tsx scripts/seed.ts",
    "validate-migrations": "tsx scripts/validate-migrations.ts",
    "check-integrity": "tsx scripts/data-integrity-checker.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@12.9.1"
}
