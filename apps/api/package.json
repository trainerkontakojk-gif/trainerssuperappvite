{
  "name": "@trainers/api",
  "version": "0.0.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./types": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:targeted": "vitest run --changed",
    "test:core": "node ../../scripts/test-core.mjs api",
    "test:fast": "node ../../scripts/test-core.mjs api fast",
    "test:full": "vitest run",
    "test:db-integration": "vitest run --config vitest.config.db-integration.ts",
    "lint": "eslint .",
    "start": "tsx src/index.ts",
    "start:telefun-scoring-worker": "tsx src/workers/telefun-scoring-worker-entrypoint.ts",
    "start:ketik-review-worker": "tsx src/workers/ketik-review-worker-entrypoint.ts",
    "backfill:scenario-attachments": "tsx src/scripts/backfill-scenario-attachments.ts",
    "optimize:kegiatan-images": "tsx src/scripts/optimize-kegiatan-images.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "@trainers/types": "workspace:*",
    "hono": "^4.13.13",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  }
}
