{
  "name": "@trainers/api",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./types": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:targeted": "vitest run --changed",
    "test:core": "node ../../scripts/test-core.mjs api",
    "test:fast": "node ../../scripts/test-core.mjs api fast",
    "test:full": "vitest run",
    "test:db-integration": "vitest run --config vitest.config.db-integration.ts",
    "lint": "eslint .",
    "start": "tsx src/index.ts",
    "start:telefun-scoring-worker": "tsx src/workers/telefun-scoring-worker-entrypoint.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "@trainers/types": "workspace:*",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
