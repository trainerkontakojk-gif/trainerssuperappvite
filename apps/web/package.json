{
  "name": "@trainers/web",
  "version": "0.0.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/deployment/guard-no-railway-dev.mjs && vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:targeted": "vitest run --config vitest.config.fast.ts --changed",
    "test:core": "node ../../scripts/test-core.mjs web",
    "test:fast": "vitest run --config vitest.config.fast.ts",
    "test:full": "vitest run",
    "test:e2e": "playwright test",
    "test:webrtc-sdp-chromium": "node --no-warnings scripts/verify-openai-webrtc-sdp-chromium.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "start": "serve dist -s -l tcp://0.0.0.0:${PORT:-3005}"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@trainers/api": "workspace:*",
    "@trainers/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.1.0",
    "hono": "^4.13.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.56.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "serve": "^14.2.6",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "4.1.12",
    "@types/node": "^22.20.5"
  }
}
