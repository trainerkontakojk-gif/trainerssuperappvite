{
  "name": "@trainers/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/deployment/guard-no-railway-dev.mjs && vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:targeted": "vitest run --config vitest.config.fast.ts --changed",
    "test:core": "vitest run --config vitest.config.fast.ts src/__tests__/logout-redirect.test.ts src/__tests__/route-guards.test.ts src/__tests__/sidak-input-legacy-refresh.test.tsx src/__tests__/top-tickets-legacy-parity.test.ts src/__tests__/telefun-session-finalizer.test.ts src/__tests__/telefun-communication-profile.test.tsx src/__tests__/pdkt-mailbox.test.tsx src/__tests__/ketik-review-progress.test.tsx",
    "test:fast": "vitest run --config vitest.config.fast.ts",
    "test:full": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "start": "serve dist -s -l tcp://0.0.0.0:${PORT:-3005}"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@trainers/api": "workspace:*",
    "@trainers/types": "workspace:*",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.39.0",
    "hono": "^4.12.27",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "serve": "^14.2.6",
    "sonner": "^2.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "4.0.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.6"
  }
}
