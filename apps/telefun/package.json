{
  "name": "@trainers/telefun",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:targeted": "vitest run --changed",
    "test:core": "node ../../scripts/test-core.mjs telefun",
    "test:fast": "vitest run",
    "test:full": "vitest run",
    "lint": "eslint .",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@trainers/types": "workspace:*",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.15.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
